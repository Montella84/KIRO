# AI Summarizer (optional — the app works fully offline without these)
# Set OPENAI_API_KEY to enable LLM-powered event summarization and session digests.
OPENAI_API_KEY=

# Override the base URL if using a compatible API (e.g. Azure OpenAI, local LLM proxy).
# Defaults to the official OpenAI endpoint when left blank.
OPENAI_BASE_URL=

# Port for the Express webhook/session server. Defaults to 3001.
SESSION_PORT=3001
